using Gtk 4.0;
using Adw 1;

template $CcBackgroundPanel: $CcPanel {
  child: Adw.BreakpointBin {
    width-request: 346;
    height-request: 200;

    Adw.Breakpoint {
      condition ("max-width: 420px")

      setters {
        accent_box.spacing: 6;
        accent_box.margin-top: 6;
        accent_box.margin-bottom: 6;
      }
    }

    child: Adw.ToolbarView {
      [top]
      Adw.HeaderBar {}

      content: Adw.ToastOverlay toast_overlay {
        child: Adw.PreferencesPage {
          Adw.PreferencesGroup {
            title: _("Style");

            Adw.PreferencesRow {
              accessible-role: group;
              activatable: false;
              focusable: false;

              Adw.Clamp {
                maximum-size: 400;
                tightening-threshold: 300;

                Grid {
                  column-homogeneous: true;
                  column-spacing: 24;
                  row-spacing: 12;
                  margin-start: 12;
                  margin-end: 12;
                  margin-top: 18;
                  margin-bottom: 12;
                  hexpand: true;

                  ToggleButton default_toggle {
                    accessibility {
                      labelled-by: [
                        default_label,
                      ];
                    }

                    notify::active => $on_color_scheme_toggle_active_cb(template);

                    $CcBackgroundPreview default_preview {}

                    styles [
                      "background-preview-button",
                    ]

                    layout {
                      column: 0;
                      row: 0;
                    }
                  }

                  Label default_label {
                    label: _("_Default");
                    use-underline: true;
                    mnemonic-widget: default_toggle;

                    layout {
                      column: 0;
                      row: 1;
                    }
                  }

                  ToggleButton dark_toggle {
                    group: default_toggle;

                    accessibility {
                      labelled-by: [
                        dark_label,
                      ];
                    }

                    notify::active => $on_color_scheme_toggle_active_cb(template);

                    $CcBackgroundPreview dark_preview {
                      is-dark: true;
                    }

                    styles [
                      "background-preview-button",
                    ]

                    layout {
                      column: 1;
                      row: 0;
                    }
                  }

                  Label dark_label {
                    label: _("Da_rk");
                    use-underline: true;
                    mnemonic-widget: dark_toggle;

                    layout {
                      column: 1;
                      row: 1;
                    }
                  }
                }
              }
            }
          }

          Adw.PreferencesGroup {
            title: _("Accent Color");

            Adw.PreferencesRow {
              accessible-role: group;
              activatable: false;
              focusable: false;

              Box accent_box {
                spacing: 12;
                margin-top: 12;
                margin-bottom: 12;
                halign: center;
              }
            }
          }

          Adw.PreferencesGroup dash_group {
            title: _("Dash");
            description: _("Customize the application dock in the overview.");

            Adw.SwitchRow dash_dock_enabled_row {
              title: _("Show on Desktop");
              subtitle: _("Keep the dash visible as a dock on the desktop");
            }

            Adw.ComboRow dash_dock_position_row {
              title: _("Dock Position");
              model: StringList {
                strings [
                  _("Bottom"),
                  _("Left"),
                  _("Right"),
                ]
              };
            }

            Adw.SwitchRow dash_dock_autohide_row {
              title: _("Automatically Hide");
              subtitle: _("Reveal the dock when the pointer touches its screen edge");
            }

            Adw.SwitchRow dash_dock_reserve_row {
              title: _("Reserve Space");
              subtitle: _("Keep maximized windows clear of the dock");
            }

            Adw.ComboRow dash_alignment_row {
              title: _("Alignment");
              model: StringList {
                strings [
                  _("Center"),
                  _("Left"),
                  _("Right"),
                ]
              };
            }

            Adw.SpinRow dash_icon_size_row {
              title: _("Icon Size");
              adjustment: Adjustment {
                lower: 32;
                upper: 128;
                step-increment: 8;
                page-increment: 16;
              };
            }

            Adw.SpinRow dash_icon_spacing_row {
              title: _("Icon Spacing");
              adjustment: Adjustment {
                lower: 0;
                upper: 32;
                step-increment: 1;
                page-increment: 4;
              };
            }

            Adw.SpinRow dash_max_icons_row {
              title: _("Maximum Icons per Row");
              subtitle: _("Set to 0 for no limit");
              adjustment: Adjustment {
                lower: 0;
                upper: 64;
                step-increment: 1;
                page-increment: 4;
              };
            }

            Adw.ComboRow dash_click_action_row {
              title: _("Click Action");
              model: StringList {
                strings [
                  _("Launch"),
                  _("Minimize"),
                  _("Switch Windows"),
                  _("Focus or Launch"),
                ]
              };
            }

            Adw.SwitchRow dash_window_previews_row {
              title: _("Show Window Previews on Hover");
            }

            Adw.SwitchRow dash_running_indicator_row {
              title: _("Show Running Indicator");
            }

            Adw.SwitchRow dash_labels_row {
              title: _("Show App Names on Hover");
            }

            Adw.SpinRow dash_animation_row {
              title: _("Animation Duration");
              subtitle: _("Milliseconds");
              adjustment: Adjustment {
                lower: 0;
                upper: 1000;
                step-increment: 50;
                page-increment: 100;
              };
            }

            Adw.SwitchRow dash_background_blur_row {
              title: _("Blur Background");
            }

            Adw.ActionRow dash_background_color_row {
              title: _("Background Color");

              [suffix]
              ColorDialogButton dash_background_color_button {
                valign: center;
              }
            }

            Adw.SpinRow dash_background_opacity_row {
              title: _("Background Opacity");
              subtitle: _("Percent");
              adjustment: Adjustment {
                lower: 0;
                upper: 100;
                step-increment: 5;
                page-increment: 10;
              };
            }

            Adw.SpinRow dash_corner_radius_row {
              title: _("Corner Radius");
              adjustment: Adjustment {
                lower: 0;
                upper: 64;
                step-increment: 1;
                page-increment: 4;
              };
            }

            Adw.SpinRow dash_border_width_row {
              title: _("Border Width");
              adjustment: Adjustment {
                lower: 0;
                upper: 8;
                step-increment: 1;
                page-increment: 2;
              };
            }

            Adw.ActionRow dash_border_color_row {
              title: _("Border Color");

              [suffix]
              ColorDialogButton dash_border_color_button {
                valign: center;
              }
            }
          }

          Adw.PreferencesGroup {
            title: _("Background");

            header-suffix: Button {
              Adw.ButtonContent {
                icon-name: "list-add-symbolic";
                label: _("_Add Picture…");
                use-underline: true;
              }

              clicked => $on_add_picture_button_clicked_cb(template);

              styles [
                "flat",
              ]
            };

            Adw.Bin {
              styles [
                "card",
              ]
              accessibility {
                label: _("Background");
              }
              accessible-role: group;

              $CcBackgroundChooser background_chooser {
                hexpand: true;
                toast-overlay: toast_overlay;
                background-chosen => $on_chooser_background_chosen_cb(template);
              }
            }
          }
        };
      };
    };
  };
}
